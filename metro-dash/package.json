{
  "name": "metro-dash",
  "version": "1.0.0",
  "description": "Metro Dash - 3D endless runner game",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "worker": "bun src/worker.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "build:client": "rm -rf dist && mkdir -p dist && cp -R client/. dist/",
    "build": "bun run build:client",
    "lint": "eslint src/",
    "format": "prettier --write .",
    "test:smoke": "bun .qa/wave2-smoke.mjs && bun .qa/wave3-smoke.mjs && bun .qa/wave4-smoke.mjs && bun .qa/wave5-smoke.mjs && bun .qa/wave6-smoke.mjs && bun .qa/ui-ux-smoke.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@elysiajs/static": "^1.4.10",
    "@tweenjs/tween.js": "^25.0.0",
    "@types/bun": "^1.3.14",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.4",
    "elysia": "^1.2.19",
    "pg": "^8.13.1",
    "three": "^0.172.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/three": "^0.172.0",
    "drizzle-kit": "^0.30.4",
    "typescript": "^5.7.2",
    "playwright-core": "^1.63.0"
  }
}
