; Engine configuration file.
; Continuity Error — Phase 0 risk-validation prototype.
config_version=5

[application]
config/name="Continuity Error"
run/main_scene="res://scenes/test_room.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.018, 0.027, 0.055, 1)

[input]
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65),Object(InputEventKey,"physical_keycode":4194311)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68),Object(InputEventKey,"physical_keycode":4194313)]}
move_up={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87),Object(InputEventKey,"physical_keycode":4194320)]}
move_down={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83),Object(InputEventKey,"physical_keycode":4194322)]}
topology_edit={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":69),Object(InputEventMouseButton,"button_index":2)]}
cancel={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":4194305)]}
camera_zoom_in={"deadzone":0.2,"events":[Object(InputEventMouseButton,"button_index":4)]}
camera_zoom_out={"deadzone":0.2,"events":[Object(InputEventMouseButton,"button_index":5)]}

