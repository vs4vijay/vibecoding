# Database Configuration
# `bun run dev` sets this automatically for web and worker. Use this value when
# running either process separately alongside `bun run dev:db`:
DATABASE_URL="postgresql://postgres@127.0.0.1:5433/postgres"

# Optional PGlite socket owner settings
PGLITE_DATA_DIR="./dev.db"
PGLITE_PORT="5433"

# For production PostgreSQL, use:
# DATABASE_URL="postgresql://user:password@localhost:5432/mydb"

# Environment
NODE_ENV="development"
