# Database connection string.
# `bun run dev` sets this automatically for the web app and the worker. Use this
# value when running either process separately alongside `bun run dev:db`:
DATABASE_URL="postgresql://postgres@127.0.0.1:5433/postgres"

# For production PostgreSQL, use:
# DATABASE_URL="postgresql://user:password@host:5432/database"

# Optional: connections per process (default 5)
# DATABASE_POOL_SIZE="5"

# Optional: local PGlite socket server settings (development only).
# If you change PGLITE_PORT, change the port in DATABASE_URL to match.
# PGLITE_DATA_DIR="./dev.db"
# PGLITE_HOST="127.0.0.1"
# PGLITE_PORT="5433"
