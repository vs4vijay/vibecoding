# ------------------------------------------------------------------
# lkml-pr-dashboard environment configuration
# Copy to `.env` and adjust. All values are validated at startup
# (fail-fast). See src/config/index.ts for the validation rules.
# ------------------------------------------------------------------

# Runtime mode: development | test | production
NODE_ENV=development

# Storage backend: pglite (zero-config local/dev/testing) | postgres (production)
DB_BACKEND=pglite

# PGLite data directory (relative to project root).
# Use `:memory:` for an ephemeral in-memory database.
PGLITE_DATA_DIR=.pglite

# Required only when DB_BACKEND=postgres.
# Example: postgres://user:pass@localhost:5432/lkml
# DATABASE_URL=

# HTTP server binding
API_HOST=0.0.0.0
API_PORT=5174

# LKML data source: patchwork | lore | sample
#   patchwork -> real kernel patch series via patchwork.kernel.org API (works from most hosts)
#   lore      -> real LKML archive via lore.kernel.org (often Anubis anti-bot protected)
#   sample    -> deterministic offline sample dataset (no network needed)
LKML_SOURCE=patchwork

# Number of series to fetch per ingest run (1..500)
LKML_FETCH_LIMIT=60

# How often (ms) the dev scheduler enqueues a background ingest job
LKML_FETCH_INTERVAL_MS=900000

# HTTP timeout (ms) for upstream LKML fetches
LKML_HTTP_TIMEOUT_MS=30000

# Number of concurrent claim loops running in the worker process (1..16)
WORKER_CONCURRENCY=2

# Optional stable worker id (defaults to worker-<pid>-<random>)
# WORKER_ID=

# How often (ms) the worker polls the queue when no NOTIFY was received
JOB_POLL_INTERVAL_MS=1000

# Max attempts for a background job before it is marked failed
JOB_MAX_ATTEMPTS=3

# Seed the database with data on startup if it is empty
SEED_ON_START=true

# Periodically enqueue ingest jobs while running
AUTO_INGEST=true

# Log verbosity: debug | info | warn | error
LOG_LEVEL=info
