{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "bundler", "resolveJsonModule": true,
    "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true, "verbatimModuleSyntax": true, "isolatedModules": true,
    "noEmit": true, "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "paths": { "@sim/*": ["./src/sim/*"], "@render/*": ["./src/render/*"], "@content/*": ["./src/content/*"] }
  },
  "include": ["src", "tests"]
}
